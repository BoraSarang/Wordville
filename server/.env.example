# Wordville Server 환경변수 템플릿
# 키 만료 규칙: 각 줄 끝에 "# expires: YYYY-MM-DD owner: @이름" 형식으로 기록

# 배포 대상: local | render (render면 디버그 라우트 비활성)
DEPLOY_TARGET=local

# Google Gemini API (1순위 LLM — 문제 생성/심판, gemini-2.5-flash)
GEMINI_API_KEY=AQ.xxx # expires: 2026-12-31 owner: @borasarang

# OpenCode Zen API (2순위 폴백 LLM — deepseek-v4-flash-free 무료)
ZEN_API_KEY=sk-xxx # expires: 2026-12-31 owner: @borasarang

# OpenRouter API (오답 규칙 임베딩 전용 — text-embedding-3-small)
OPENROUTER_API_KEY=sk-or-v1-xxx # expires: 2026-12-31 owner: @borasarang

# Neon PostgreSQL
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

PORT=3000
NODE_ENV=development
DEBUG_LOGS=true
CORS_ORIGINS=*
JWT_SECRET=change-me
