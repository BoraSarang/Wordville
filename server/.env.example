# --- Wordville 환경 변수 (복사해서 .env로 사용) ---
# .env는 절대 커밋 금지 (gitignore 확인)

# OpenRouter API 키 (문제 생성/심판 LLM)
# 발급: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY= # expires: 2026-12-31 owner: @borasarang

# Neon PostgreSQL 연결 문자열 (pooler)
# 참고: pgvector 확장은 관리 콘솔에서 CREATE EXTENSION vector; 필요
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 서버
PORT=3000
NODE_ENV=development

# 디버그
DEBUG_LOGS=true

# CORS (개발: 모든 출처 허용)
CORS_ORIGINS=*