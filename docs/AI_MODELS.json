{
  "version": "0.1.2",
  "language_lock": {
    "response": "ko",
    "reasoning": "ko",
    "enforced": true
  },
  "doc_first": {
    "enabled": true,
    "required_files": [
      "docs/plans/PLAN_v0.1_common.md",
      "docs/TODO.md",
      "docs/DESIGN.md"
    ],
    "session_auto_save_minutes": 15
  },
  "default_chain": [
    "google/gemini-3.5-flash-lite"
  ],
  "models": {
    "chat": {
      "model": "google/gemini-3.5-flash-lite",
      "temperature": 0.2,
      "max_tokens": 4096,
      "prompt_version": "chat_v0.1",
      "vision_support": false,
      "note": "deepseek-v4-flash-* 미존재/토큰소모 문제 → gemini-3.5-flash-lite (in $0.0000003, ~1.2s 응답)"
    },
    "code": {
      "model": "google/gemini-3.5-flash-lite",
      "temperature": 0.1,
      "max_tokens": 8192,
      "prompt_version": "code_v0.1",
      "vision_support": false,
      "note": "deepseek-v4-flash-* 미존재/토큰소모 문제 → gemini-3.5-flash-lite (in $0.0000003, ~1.2s 응답)"
    },
    "judge": {
      "model": "google/gemini-3.5-flash-lite",
      "temperature": 0.0,
      "max_tokens": 1024,
      "prompt_version": "judge_v0.1",
      "vision_support": false,
      "note": "deepseek-v4-flash-* 미존재/토큰소모 문제 → gemini-3.5-flash-lite (in $0.0000003, ~1.2s 응답)"
    }
  },
  "platforms": {
    "macos": {
      "model": "code",
      "perf_budget": {
        "cold_start_ms": 1500,
        "fps": 60
      }
    },
    "android": {
      "model": "code",
      "perf_budget": {
        "cold_start_ms": 2000,
        "fps": 60
      }
    },
    "server": {
      "model": "judge",
      "perf_budget": {
        "p95_ms": 300,
        "memory_mb": 400
      }
    }
  },
  "cache_policy": {
    "enabled": true,
    "ttl_days": 7,
    "max_entries_server": 10000,
    "hit_rate_target": 0.7,
    "storage": "server in-memory + DB(questions 중복 방지)"
  },
  "cost_guard": {
    "max_cost_per_task_usd": 0.01,
    "alert_at_usd": 0.005,
    "note": "gemini-3.5-flash-lite: 5문항 생성+심판 루프 4회 ≈ 15k tokens ≈ $0.005 미만 (사실상 무료)"
  },
  "e2e": {
    "k6_threshold_p95_ms": 300
  }
}